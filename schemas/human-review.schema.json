{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vis-agent-bench.local/schemas/human-review.schema.json",
  "title": "Vis Agent Bench Human Review Package",
  "type": "object",
  "required": ["schema_version", "run_id", "reviewer", "isolation", "reviews", "reviewed_at"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "isolation": { "type": "string" },
    "machine_evidence_ref": { "type": ["string", "null"] },
    "blind_review": { "type": "boolean" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
          "required": ["case_id", "complete", "decision", "scores", "human_time", "convergence", "observations"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "complete": { "type": "boolean" },
          "decision": {
            "type": ["string", "null"],
            "enum": ["accepted", "accepted-with-fixes", "partial", "rejected", "invalid-run", null]
          },
          "machine_evidence": {
            "type": ["object", "null"],
            "required": ["run_id", "capture_id", "captured_at"],
            "properties": {
              "run_id": { "type": "string", "minLength": 1 },
              "capture_id": { "type": "string", "minLength": 1 },
              "captured_at": { "type": "string" }
            },
            "additionalProperties": false
          },
          "scores": {
            "type": "object",
            "required": ["business", "visual", "interaction", "usability"],
            "properties": {
              "business": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
              "visual": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
              "interaction": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
              "usability": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
            },
            "additionalProperties": false
          },
          "human_time": {
            "type": "object",
            "required": [
              "clarification_minutes",
              "context_prep_minutes",
              "poc_review_minutes",
              "micro_adjustment_minutes",
              "fix_minutes",
              "final_review_minutes"
            ],
            "properties": {
              "clarification_minutes": { "type": "integer", "minimum": 0 },
              "context_prep_minutes": { "type": "integer", "minimum": 0 },
              "poc_review_minutes": { "type": "integer", "minimum": 0 },
              "micro_adjustment_minutes": { "type": "integer", "minimum": 0 },
              "fix_minutes": { "type": "integer", "minimum": 0 },
              "final_review_minutes": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "convergence": {
            "type": "object",
            "required": [
              "clarification_rounds",
              "iterations_to_acceptance",
              "micro_adjustment_items",
              "must_have_misses",
              "requirement_regressions",
              "first_poc_fitness_percent"
            ],
            "properties": {
              "clarification_rounds": { "type": "integer", "minimum": 0 },
              "iterations_to_acceptance": { "type": "integer", "minimum": 0 },
              "micro_adjustment_items": { "type": "integer", "minimum": 0 },
              "must_have_misses": { "type": "integer", "minimum": 0 },
              "requirement_regressions": { "type": "integer", "minimum": 0 },
              "first_poc_fitness_percent": { "type": "integer", "minimum": 0, "maximum": 100 }
            },
            "additionalProperties": false
          },
          "observations": {
            "type": "object",
            "required": ["strengths", "problems", "required_fixes", "management_judgment"],
            "properties": {
              "strengths": { "type": "string" },
              "problems": { "type": "string" },
              "required_fixes": { "type": "string" },
              "management_judgment": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "reviewed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
